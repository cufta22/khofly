{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  // Let postcss handle css files
  // "css.validate": false,
  "files.associations": {
    "*.css": "postcss"
  },
  "emmet.includeLanguages": {
    "postcss": "css",
    "css": "css"
  },
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false
}
